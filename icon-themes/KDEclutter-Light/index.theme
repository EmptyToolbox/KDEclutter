[Icon Theme]
Name=KDEclutter-Light
Comment=Minimalist iOS/Android-inspired system tray icon pack for light KDE Plasma panels
FollowsColorScheme=true
Inherits=breeze,hicolor
Directories=status/22,devices/22,apps/22

[status/22]
Size=22
Context=Status
Type=Scalable
MinSize=16
MaxSize=256

[devices/22]
Size=22
Context=Devices
Type=Scalable
MinSize=16
MaxSize=256

[apps/22]
Size=22
Context=Applications
Type=Scalable
MinSize=16
MaxSize=256
